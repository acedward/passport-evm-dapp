# MN Bank: every setting, with its meaning. Copy to deploy/.env (git-ignored) and fill in.
#
# SECRETS ARE NEVER WRITTEN IN THIS FILE. The two secrets (the sponsor wallet's seed and the
# Sepolia RPC URL, which carries an API key) are files on the host, mounted read-only into the
# relay; set the *_FILE variables to their paths inside the container.

# ── Compose ──────────────────────────────────────────────────────────────────
# Unique per deployment or test run, so containers, volumes and images never collide.
COMPOSE_PROJECT_NAME=mnbank-dev
IMAGE_TAG=dev
# Host ports (bound to 127.0.0.1). Pick free ports above 10000.
RELAY_HOST_PORT=18080
WEB_HOST_PORT=18081

# ── Network ─────────────────────────────────────────────────────────────────
# "stagenet" (the live staging network) or "undeployed" (the local ledger-9 stack).
RELAY_NETWORK=undeployed
# Every endpoint of the profile can be overridden; leave empty to keep the profile's default.
# Midnight node (HTTP and WebSocket) and indexer (GraphQL HTTP and WebSocket).
MIDNIGHT_NETWORK_ID=
MIDNIGHT_NODE_URL=
MIDNIGHT_NODE_WS_URL=
MIDNIGHT_INDEXER_URL=
MIDNIGHT_INDEXER_WS_URL=
MIDNIGHT_EXPLORER_URL=
# The ZSwap offer-files kernel API, the batcher, its settlement target and the public site.
ZSWAP_KERNEL_URL=
ZSWAP_BATCHER_URL=
ZSWAP_BATCHER_TARGET=
ZSWAP_SITE_URL=
# The ERC20 vault on Midnight, its EVM account on Sepolia, the Sig Network singleton, the MPC
# root key (0x04…) and the MPC output cache. Stagenet takes these from PR #4's records; the local
# stack deploys a new vault every time, so they must be set for "undeployed".
BRIDGE_VAULT_ADDRESS=
BRIDGE_VAULT_EVM_ADDRESS=
BRIDGE_SIGNET_SINGLETON=
BRIDGE_MPC_ROOT_PUBLIC_KEY=
BRIDGE_MPC_OUTPUT_CACHE_URL=
BRIDGE_EXPLORER_URL=
# A JSON token list mapping Midnight colours to the "usdc" and "stock" roles (required for
# "undeployed"; optional for stagenet, which uses the vendored PR #4 records).
TOKENS_FILE=

# ── Relay ───────────────────────────────────────────────────────────────────
RELAY_HOST=0.0.0.0
RELAY_PORT=8080
# Trust the last X-Forwarded-For hop for rate limiting (only behind your own reverse proxy).
RELAY_TRUST_PROXY=false
# Browser origins allowed to call the relay, comma-separated (the web app's origin).
RELAY_CORS_ORIGINS=
# Largest accepted request body, in bytes.
RELAY_MAX_BODY_BYTES=1048576
LOG_LEVEL=info

# ── Proof server and keys ────────────────────────────────────────────────────
# The relay's one proof server (midnightntwrk/proof-server 9.0.0-rc.6, pinned by digest).
MIDNIGHT_PROOF_SERVER_URL=http://proof-server:6300
PROOF_SERVER_EXPECTED_VERSION=9.0.0-rc.6
# The read-only key volume (compiled contracts with prover keys), and its pinned fingerprint.
# With a fingerprint set, the relay refuses to start on any other key set.
MIDNIGHT_MANAGED_PATH=
RELAY_KEYS_FINGERPRINT=

# ── Sponsor wallet (pays every DUST fee) ─────────────────────────────────────
SPONSOR_ENABLED=false
# Path of the file holding the seed: a hex seed, a BIP-39 mnemonic, or one WALLET=/SEED= line.
SPONSOR_SEED_FILE=
# A seed shared with other tools: the shared lock file the relay takes before opening it.
SPONSOR_FUNDING_LOCK_FILE=
# Or declare that the seed is dedicated to this relay (then no lock is needed).
SPONSOR_DEDICATED_WALLET=false
# The wallet SDK's fee margin in blocks: it declares (and spends) fee × 1.046^margin. 20 is the
# tested value (plan question Q19): 5 fails the registration's activation, 100 spends about 89×.
SPONSOR_FEE_BLOCKS_MARGIN=20
# Refuse spending actions below this DUST balance, in specks (1 DUST = 10^15 specks).
SPONSOR_DUST_LOW_SPECKS=10000000000000000

# ── Sepolia ─────────────────────────────────────────────────────────────────
# Path of the file holding the Sepolia RPC URL (used for the vault gas check and the bridge).
SEPOLIA_RPC_URL_FILE=
# Health reports low withdrawal gas below this balance on the vault's EVM account, in wei.
VAULT_GAS_LOW_WEI=2000000000000000

# ── Limits ──────────────────────────────────────────────────────────────────
RATE_LIMIT_READS_PER_MIN=240
RATE_LIMIT_NONCES_PER_MIN=30
RATE_LIMIT_ACTIONS_PER_MIN=10
RATE_LIMIT_ACTIONS_PER_OWNER_PER_MIN=5
# How far ahead an authorisation's expiry may be, and how long an issued nonce lives (seconds).
AUTH_MAX_TTL_SECONDS=600
AUTH_NONCE_TTL_SECONDS=600
AUTH_MAX_NONCES=50000
# How long a finished job stays resumable, and the most jobs held at once.
JOB_TTL_SECONDS=86400
JOB_MAX=10000
HEALTH_CACHE_SECONDS=15
